# 로컬 MongoDB 적재 설정
DATALAKE_HOST="localhost"
DATALAKE_PORT=27017
DATALAKE_USER=""
DATALAKE_PASSWORD=""
DATALAKE_DB_NAME="studygroup"
# 비워 두면 DATALAKE_DB_NAME을 인증 DB로 사용
DATALAKE_AUTH_SOURCE=""

# --profile legacy의 단일 적재 컬렉션
DATALAKE_COLLECTION_NAME="binance_events"

# --profile multi-stream의 스트림별 적재 컬렉션
DATALAKE_AGG_TRADES_COLLECTION_NAME="agg_trades"
DATALAKE_ORDER_BOOK_DEPTH_COLLECTION_NAME="order_book_depth"
DATALAKE_BOOK_TICKERS_COLLECTION_NAME="book_tickers"
DATALAKE_KLINES_COLLECTION_NAME="klines"
DATALAKE_MARK_PRICES_COLLECTION_NAME="mark_prices"
DATALAKE_COLLECTOR_CONTROL_COLLECTION_NAME="collector_control"

# profile과 스트림 주기는 실행 옵션으로 지정한다.
# python -m src.run_mongodb --profile multi-stream \
#   --kline-interval 1m --depth-speed 100ms --mark-price-speed 1s
