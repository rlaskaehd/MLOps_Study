# 로컬 MongoDB 적재 설정
DATALAKE_HOST="localhost"
DATALAKE_PORT=27017
DATALAKE_USER=""
DATALAKE_PASSWORD=""
DATALAKE_DB_NAME="studygroup"
# 비워 두면 DATALAKE_DB_NAME을 인증 DB로 사용
DATALAKE_AUTH_SOURCE=""

# --profile legacy의 단일 적재 컬렉션
DATALAKE_COLLECTION_NAME="binance_events"

# --profile multi-stream은 같은 DB에 아래 고정 컬렉션을 사용한다.
# agg_trades, order_book_depth, book_tickers, klines, mark_prices,
# collector_control
# profile과 스트림 주기 설정은 실행 옵션으로 지정한다.
# python -m src.run_mongodb --profile multi-stream \
#   --kline-interval 1m --depth-speed 100ms --mark-price-speed 1s
